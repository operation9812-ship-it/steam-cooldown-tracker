{
  "name": "steam-cooldown-app",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.steam.cooldown.app",
    "productName": "SteamCooldownTracker",
    "publish": [
      {
        "provider": "github",
        "owner": "operation9812",
        "repo": "steam-cooldown-tracker"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-reload": "^2.0.0-alpha.1",
    "electron-updater": "^6.8.9"
  }
